<caml:Description xmlns="http://www.w3.org/1999/xhtml"><caml:Id>20250AB__011599INT</caml:Id><caml:VersionNum>99</caml:VersionNum><caml:History><caml:Action><caml:ActionText>INTRODUCED</caml:ActionText><caml:ActionDate>2025-01-08</caml:ActionDate></caml:Action></caml:History><caml:LegislativeInfo><caml:SessionYear>2025</caml:SessionYear><caml:SessionNum>0</caml:SessionNum><caml:MeasureType>AB</caml:MeasureType><caml:MeasureNum>115</caml:MeasureNum><caml:MeasureState>INT</caml:MeasureState></caml:LegislativeInfo><caml:AuthorText authorType="LEAD_AUTHOR">Introduced by Assembly Member Gabriel</caml:AuthorText><caml:Authors><caml:Legislator><caml:Contribution>LEAD_AUTHOR</caml:Contribution><caml:House>ASSEMBLY</caml:House><caml:Name>Gabriel</caml:Name></caml:Legislator></caml:Authors><caml:Title> An act relating to the Budget Act of 2025. </caml:Title><caml:RelatingClause>the Budget Act of 2025</caml:RelatingClause><caml:GeneralSubject><caml:Subject>Budget Act of 2025.</caml:Subject></caml:GeneralSubject><caml:DigestText><p>This bill would express the intent of the Legislature to enact statutory changes relating to the Budget Act of 2025.</p></caml:DigestText><caml:DigestKey><caml:VoteRequired>MAJORITY</caml:VoteRequired><caml:Appropriation>NO</caml:Appropriation><caml:FiscalCommittee>NO</caml:FiscalCommittee><caml:LocalProgram>NO</caml:LocalProgram></caml:DigestKey><caml:MeasureIndicators><caml:ImmediateEffect>NO</caml:ImmediateEffect><caml:ImmediateEffectFlags><caml:Urgency>NO</caml:Urgency><caml:TaxLevy>NO</caml:TaxLevy><caml:Election>NO</caml:Election><caml:UsualCurrentExpenses>NO</caml:UsualCurrentExpenses><caml:BudgetBill>NO</caml:BudgetBill><caml:Prop25TrailerBill>NO</caml:Prop25TrailerBill></caml:ImmediateEffectFlags></caml:MeasureIndicators></caml:Description><caml:Bill id="bill" xmlns="http://www.w3.org/1999/xhtml"><caml:Preamble>The people of the State of California do enact as follows:</caml:Preamble><caml:BillSection id="id_58B45E0E-35A0-447D-99B6-319C9AEB784B"><caml:Num>SECTION 1.</caml:Num><caml:Content><p>It is the intent of the Legislature to enact statutory changes relating to the Budget Act of 2025.</p></caml:Content></caml:BillSection></caml:Bill></caml:MeasureDoc>