# Copy to .env (git-ignored) and adjust. All variables are optional.
# Postgres connection string; when unset an embedded PGlite database in data/pglite is used.
DATABASE_URL=
# Feature flag gating the semantic (vector) half of hybrid search.
FEATURE_SEMANTIC_SEARCH=true
PORT=4000
LOG_LEVEL=info
# Next.js: where /api/* is proxied to, and the WebSocket URL used by the browser.
API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
# Password for the docker-compose Postgres container (choose your own; never commit .env).
POSTGRES_PASSWORD=
